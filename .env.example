PORT=3001
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API.
# Required in production (NODE_ENV=production with this unset = all cross-origin
# requests are blocked, fail-safe). Not required in development.
CORS_ORIGIN=http://localhost:3000

# Local MySQL Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root1234
DB_NAME=smart_school

# Note: Prisma CLI doesn't natively support interpolation (e.g. ${DB_USER}) in the .env file.
# You must write the full string here for Prisma commands to work correctly.
DATABASE_URL="mysql://root:root1234@127.0.0.1:3306/smart_school"

# JWT Secret for authentication
JWT_SECRET=your_super_secret_jwt_key
# Short on purpose — a refresh token (30-day, revocable, DB-backed) now carries
# the "stay logged in" duration; see backend/src/application/use-cases/auth/LoginUseCase.ts
JWT_EXPIRES_IN=15m

# Telegram Bot API (for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=default_chat_id_for_testing

# Shared secret gate/attendance scanners must send as the X-Device-Key header
# on POST /api/attendance/scan (that endpoint has no user login, so this is
# its only access control). Generate a long random value for real deployments.
DEVICE_API_KEY=change_me_to_a_long_random_value
