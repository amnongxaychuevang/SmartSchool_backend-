# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -hex 32
# Use hex values for the DB passwords: they go inside a URL (DATABASE_URL).

# Public addresses (what the browser uses)
PUBLIC_URL=https://edusmart.phousam.com
API_PUBLIC_URL=https://edusmart.phousam.com/api

# Host ports nginx proxies to (bound to 127.0.0.1). Must not clash with other apps.
API_PORT=5100
WEB_PORT=3100

# Database (its own MySQL container; not shared with any other app)
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Auth: at least 32 random characters, or the API refuses to start
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Gate scanners authenticate with this key
DEVICE_API_KEY=

# First admin account, created by `prisma db seed` (only if that email does not exist).
# Required: the seed refuses to run in production without them. Password: 12+ characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Nightly backup also archives uploads/ and storage/ (photos, documents). 0 = database only.
# BACKUP_FILES=1

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
